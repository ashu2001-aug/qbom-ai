# Q-BOM AI — Environment Variables. Copy to .env and fill in your values.

# ── Azure OpenAI ───────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── LangSmith (tracing) ────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=qbom-ai

# ── Pinecone ───────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX=qbom-crypto-index
PINECONE_ENV=us-east-1

# ── PostgreSQL ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/qbom
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ── HuggingFace ────────────────────────────────────────────────
HF_TOKEN=hf_your_token_here

# ── OpenTelemetry (leave blank to disable) ─────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-collector:4317
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── App ────────────────────────────────────────────────────────
SECRET_KEY=change-me-use-secrets-manager-in-production
ENVIRONMENT=development
SCHEDULER_ENABLED=false
